<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the session tokens (core's KeystoreTokenStore) never leave the device. Their Keystore key can't be
     moved either, so a restored copy could not be decrypted anyway; the owner signs in again on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="webblock_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webblock_session.xml" />
    </device-transfer>
</data-extraction-rules>
